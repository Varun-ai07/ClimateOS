# ClimateNarrative Environment Variables

# LLM API Keys (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # optional, for secondary LLM

# Demo Configuration
DEMO_CACHE_PATH=./data/demo_cache/coimbatore_flood.json
DEMO_EMAIL=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=climate@demo.local
MAIL_TO=officials@demo.local

# Negotiation Thresholds
SFS_THRESHOLD=0.8
AS_THRESHOLD=0.7
MAX_NEGOTIATION_ROUNDS=3